# --- Database (PostgreSQL, AU region in all deployed environments) ---
# Local dev (docker-compose / local Postgres): point both at the same DB.
DATABASE_URL="postgresql://getbooked:getbooked@localhost:5432/getbooked"
DIRECT_URL="postgresql://getbooked:getbooked@localhost:5432/getbooked"

# Supabase (project MUST be in the Sydney region, ap-southeast-2 — §10.1):
#   DATABASE_URL = Supavisor transaction pooler, used by the app at runtime:
#     postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct connection, used by `prisma migrate` (DDL can't run
#                  through the transaction pooler):
#     postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase project identity + client-side config (for the Next.js app).
# The publishable key is safe in the browser, but real values still live in
# .env / the platform secret store, not in this template.
SUPABASE_PROJECT_REF=""
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Claude API (AI components: referral extraction, search synonym mapping) ---
# Never commit a real key. In deployed environments this is injected from the
# secrets manager. See docs/architecture.md §AI for the data-residency gate that
# must be satisfied before identifiable health information is sent to this endpoint.
ANTHROPIC_API_KEY=""
# Optional override so traffic can be pinned to a compliant/approved endpoint.
ANTHROPIC_BASE_URL=""

# --- Redis (slot holds, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Publishable key is safe in the browser (NEXT_PUBLIC_* prefix).
# Get from Stripe Dashboard → Developers → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- API URL (consumed by apps/web) ---
# Local: http://localhost:3001 | Production: https://api.getbooked.com.au (or Railway/Render URL)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- CORS (consumed by apps/api) ---
# Comma-separated list of allowed origins, e.g. https://getbooked-web.netlify.app
ALLOWED_ORIGINS="http://localhost:3000"
