# --- Database (PostgreSQL, AU region in all deployed environments) ---
DATABASE_URL="postgresql://getbooked:getbooked@localhost:5432/getbooked"

# --- Claude API (AI components: referral extraction, search synonym mapping) ---
# Never commit a real key. In deployed environments this is injected from the
# secrets manager. See docs/architecture.md §AI for the data-residency gate that
# must be satisfied before identifiable health information is sent to this endpoint.
ANTHROPIC_API_KEY=""
# Optional override so traffic can be pinned to a compliant/approved endpoint.
ANTHROPIC_BASE_URL=""

# --- Redis (slot holds, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- SMS (Twilio/Sinch, AU sender ID) ---
SMS_PROVIDER_API_KEY=""
